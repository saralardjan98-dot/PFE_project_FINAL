# PetroView Backend — Environment Variables
# Copy this file to .env and edit as needed

# ── Security ──
SECRET_KEY=petroview-super-secret-key-change-in-production-2025
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Database ──
DATABASE_URL=postgresql://postgres:lardjan098@localhost:5432/petroview

# ── File Upload ──
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=50

# ── CORS (comma-separated allowed origins) ──
# Add your frontend URL here
CORS_ORIGINS=["http://localhost:8080","http://10.178.46.114:8080","http://localhost:5173"]

# ── Debug ──
DEBUG=true
